# ==============================================================================
# SA Map Studio - Git Ignore
# ==============================================================================

# Executaveis e distribuicoes geradas
compiled/
dist/
dist-limpo/
build/
build-info.json
*.spec
*.rar
*.zip
*.7z

# Ambiente Python e compilacao
.venv-build/
__pycache__/
*.pyc
*.pyo

# Dados do usuario e configuracoes locais
data/
projects/
exported/
test-server/
Dados/
Projetos/
Exportados/
projetos/
exportados/
Servidor de Teste/
dados-da-janela/
cache/
scratch/
scratch_*.png
bans.json
config.json
sa-map-studio.log

# Banco de dados local do open.mp (mantido localmente na raiz, nao versionar)
omp-server-source/

# Fontes de compilacao pesadas e ambiente isolado
compile-sources/cache/
compile-sources/.venv-build/

# Pasta de testes e scripts temporarios (mantem a pasta testing/, ignora o conteudo)
testing/*
!testing/.gitkeep

# Arquivos de execucao e registros do servidor de testes
server_log.txt
omp-server.log
omp-server.json
server.cfg
log.txt
*.dmp
*.pdb

# Editores e sistema operacional
.vscode/
.idea/
*.tmp
*.bak
Thumbs.db
desktop.ini
.DS_Store
