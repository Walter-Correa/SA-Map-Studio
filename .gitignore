# ==============================================================================
# SA Map Studio - Git Ignore
# ==============================================================================

# Generated executables and distributions (build output)
compiled/
build/
build-info.json
*.spec

# Isolated Python virtual environment and bytecode
compile-sources/.venv-build/
__pycache__/
*.pyc

# Local user data, projects and machine settings
/config.json
/data/config.json
!omp-server-source/config.json
sa-map-studio.log
sa-map-studio/
data/
projects/
exported/
test-server/

# Test folder (keeps the testing/ folder, ignores temporary scripts)
testing/*
!testing/.gitkeep

# Server run, dump and debug files
server_log.txt
omp-server.log
*.dmp
*.pdb

# Editors and operating system
.vscode/
.idea/
Thumbs.db
desktop.ini
