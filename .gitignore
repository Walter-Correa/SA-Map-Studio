# ==============================================================================
# SA Map Studio - Git Ignore
# ==============================================================================

# Executáveis e distribuições geradas (saída de build)
compiled/
build/
build-info.json
*.spec

# Ambiente virtual isolado do Python e bytecode
compile-sources/.venv-build/
__pycache__/
*.pyc

# Dados locais do usuário, projetos e configurações da máquina
/config.json
/data/config.json
!omp-server-source/config.json
sa-map-studio.log
sa-map-studio/
data/
projects/
exported/
test-server/

# Pasta de testes (mantém a pasta testing/, ignora scripts temporários)
testing/*
!testing/.gitkeep

# Arquivos de execução, despejo e depuração do servidor
server_log.txt
omp-server.log
*.dmp
*.pdb

# Editores e sistema operacional
.vscode/
.idea/
Thumbs.db
desktop.ini
